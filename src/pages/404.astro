---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found — Entanglo" noindex>
  <section class="container-narrow py-32 text-center">
    <div class="text-xs uppercase tracking-widest text-accent-glow mb-3">404</div>
    <h1 class="display text-6xl md:text-7xl gradient-text leading-tight">Lost the link.</h1>
    <p class="mt-5 text-ink-300 text-lg">That page isn't on this Mac.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</Base>
