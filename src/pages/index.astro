---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import FeatureCard from '@/components/FeatureCard.astro';
import AdSlot from '@/components/AdSlot.astro';
import notes from '@/data/release-notes.json';

const version = (notes[0]?.version as string) ?? '0.1.0';

const features = [
  {
    title: 'Input sharing',
    description: 'One mouse, one keyboard, every machine. Move past the edge of your screen and you\'re on the next device — clicks, drags, double-clicks, modifiers, delivered natively per OS.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12h6m6 0h6M12 3v6m0 6v6"/></svg>`,
    highlight: true,
  },
  {
    title: 'Universal clipboard',
    description: 'Copy on one machine, paste on another. Text, rich text, images — synced over your LAN in milliseconds.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="8" y="3" width="8" height="4" rx="1"/><path d="M16 5h2a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h2"/></svg>`,
  },
  {
    title: 'File drop',
    description: 'Drop a file in the link — it lands in the Downloads folder of the target device, chunked and verified.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 3v5h5M5 21V3h9l5 5v13H5z"/></svg>`,
  },
  {
    title: 'Printer Bridge',
    description: 'Print from any device to the printer wired to just one of them. The bridge swaps Wi-Fi, sends the PDF, prints, and switches back — fully transparent.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 9V3h12v6M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v7H6z"/></svg>`,
  },
  {
    title: 'Quick Actions',
    description: 'Push a URL to another machine and it opens there. Grab a live screenshot of any peer. Emergency stop in one click — always in the toolbar.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>`,
  },
  {
    title: 'Live network quality',
    description: 'Real RTT, packet loss, jitter — measured every second over the link itself, not a synthetic ping. You see exactly when the Wi-Fi misbehaves.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12c4-8 14-8 18 0M6 16c2-4 10-4 12 0M10 20c1-1 3-1 4 0"/></svg>`,
  },
];

const principles = [
  {
    title: 'Native',
    body: 'A real app on each OS — Swift on macOS, WinUI 3 on Windows, GTK4 on Linux, Kotlin on Android TV. No Electron, no web view. It runs at native speed because it is native.',
  },
  {
    title: 'Private',
    body: 'Everything stays on your LAN. No cloud, no telemetry, no account — peers find each other via Bonjour and talk directly over TCP.',
  },
  {
    title: 'Yours',
    body: 'Trusted pairing is explicit. You approve every peer once. Revoke any time. Source-of-truth for your devices lives on your machine, not ours.',
  },
];
---

<Base>
  <Hero version={version} />

  <!-- Pillars -->
  <section class="container-narrow py-16">
    <div class="grid md:grid-cols-3 gap-8">
      {principles.map(p => (
        <div class="border-l border-ink-950/15 pl-5">
          <div class="text-xs uppercase tracking-widest text-accent mb-2">{p.title}</div>
          <p class="text-ink-800 text-lg leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="divider container-narrow"></div>

  <!-- Features -->
  <section id="features" class="container-narrow py-24 md:py-32">
    <div class="max-w-2xl mb-14">
      <div class="text-xs uppercase tracking-widest text-accent mb-3">What it does</div>
      <h2 class="display text-4xl md:text-5xl gradient-text leading-tight">
        Six features. One link. Zero friction.
      </h2>
      <p class="mt-4 text-ink-700 text-lg">
        Built for the way you actually use multiple machines — at a desk, on the same Wi-Fi, jumping between devices all day.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 auto-rows-fr">
      {features.map(f => (
        <FeatureCard title={f.title} description={f.description} icon={f.icon} highlight={f.highlight} />
      ))}
    </div>
  </section>

  <AdSlot slot="home-mid" />

  <!-- Windows -->
  <section class="container-narrow py-24 md:py-32">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div>
        <div class="text-xs uppercase tracking-widest text-accent mb-3">Windows</div>
        <h2 class="display text-4xl md:text-5xl gradient-text leading-tight">
          Native on Windows 11, too.
        </h2>
        <p class="mt-5 text-ink-700 text-lg leading-relaxed">
          The same link, the same features — built native on WinUI 3, not a web wrapper.
          Input sharing, clipboard sync, file drop and printer bridge, all running from the system tray.
        </p>
        <a href="/download" class="mt-7 inline-flex btn-primary">Download for Windows</a>
      </div>
      <div class="relative">
        <div aria-hidden="true" class="absolute -inset-6 -z-10 rounded-[2rem] bg-gradient-to-br from-accent/12 via-transparent to-accent-cyan/12 blur-3xl opacity-70"></div>
        <div class="glass p-1.5 md:p-2 shadow-2xl shadow-ink-950/15 ring-1 ring-ink-950/[0.06]">
          <img
            src="/img/screens/win-dashboard.png"
            alt="Entanglo for Windows — Dashboard"
            width="1936"
            height="1048"
            class="w-full h-auto rounded-[6px]"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-narrow py-24 md:py-32">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div>
        <div class="text-xs uppercase tracking-widest text-accent mb-3">How it works</div>
        <h2 class="display text-4xl md:text-5xl gradient-text leading-tight">
          Install. Pair. Done.
        </h2>
        <p class="mt-5 text-ink-700 text-lg leading-relaxed">
          Open Entanglo on every device you own. They discover each other automatically over Bonjour.
          Approve the pairing once and the link is live — secure TCP, encrypted handshake,
          opens a single port on your private network.
        </p>
        <a href="/download" class="mt-7 inline-flex btn-primary">Get Entanglo</a>
      </div>
      <ol class="space-y-5">
        {[
          { n: '01', t: 'Install on every device', d: 'Grab the macOS, Windows, Linux or Android TV build and install it on each machine.' },
          { n: '02', t: 'Grant input permission', d: 'The OS asks once — Accessibility on macOS, UAC on Windows, the input group on Linux, root on Android TV.' },
          { n: '03', t: 'Pair on the LAN', d: 'Bonjour finds your other devices automatically. Confirm the pairing on both ends.' },
          { n: '04', t: 'Move your cursor', d: 'Push past the edge of your display — you\'re on the next machine. That\'s the link.' },
        ].map(s => (
          <li class="glass p-5 flex gap-5 items-start">
            <div class="text-2xl font-mono text-accent w-10 shrink-0">{s.n}</div>
            <div>
              <div class="font-semibold text-ink-950">{s.t}</div>
              <div class="text-sm text-ink-700 mt-1">{s.d}</div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-narrow py-24 md:py-32 text-center">
    <h2 class="display text-5xl md:text-6xl gradient-text leading-tight">
      Make your devices feel like one.
    </h2>
    <p class="mt-6 text-ink-700 text-lg max-w-xl mx-auto">
      Free. Native. Private. The link your machines were always missing.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="/download" class="btn-primary">Download {version}</a>
      <a href="/changelog" class="btn-ghost">See what's new</a>
    </div>
  </section>
</Base>
