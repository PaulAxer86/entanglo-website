---
import Base from '@/layouts/Base.astro';
import DownloadButton from '@/components/DownloadButton.astro';
import AdSlot from '@/components/AdSlot.astro';
import notes from '@/data/release-notes.json';

const latest = notes[0] as { version: string; date: string; title: string; highlights: string[] };
const version = latest?.version ?? '0.1.0';
const dmgUrl = `/downloads/Entanglo-${version}.dmg`;
---

<Base
  title={`Download Entanglo ${version} — macOS`}
  description={`Get the latest Entanglo for macOS — version ${version}. Free, native, no account.`}
>
  <section class="container-narrow pt-24 pb-12 text-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-xs text-ink-200 mb-7">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      Latest — {latest?.date}
    </div>
    <h1 class="display text-5xl md:text-7xl gradient-text leading-[1.05]">
      Entanglo {version}
    </h1>
    <p class="mt-6 text-ink-200 text-xl max-w-2xl mx-auto">{latest?.title}</p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <DownloadButton href={dmgUrl} version={`v${version}`} />
      <a href="/changelog" class="btn-ghost">Full changelog</a>
    </div>

    <p class="mt-4 text-xs text-ink-400">
      DMG · macOS 13 Ventura or newer · Apple Silicon &amp; Intel
    </p>
  </section>

  <section class="container-narrow py-12">
    <div class="glass p-8 md:p-10 max-w-3xl mx-auto">
      <div class="text-xs uppercase tracking-widest text-accent-glow mb-4">What's in this build</div>
      <ul class="space-y-3 text-ink-200">
        {latest?.highlights?.map(h => (
          <li class="flex gap-3">
            <span class="text-accent-glow shrink-0 mt-1">✦</span>
            <span class="leading-relaxed">{h}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-narrow py-12">
    <div class="grid md:grid-cols-2 gap-5">
      <div class="glass p-7">
        <div class="text-xs uppercase tracking-widest text-ink-400 mb-3">First-time install</div>
        <ol class="space-y-2 text-ink-200 text-sm list-decimal pl-5">
          <li>Open the downloaded <code class="font-mono text-accent-glow">.dmg</code>.</li>
          <li>Drag <strong>Entanglo</strong> into the <strong>Applications</strong> folder.</li>
          <li>Launch it from Applications. macOS may ask once — confirm.</li>
          <li>Grant <strong>Accessibility</strong> and <strong>Local Network</strong> when prompted.</li>
        </ol>
      </div>
      <div class="glass p-7">
        <div class="text-xs uppercase tracking-widest text-ink-400 mb-3">Updating from an older build</div>
        <p class="text-ink-200 text-sm leading-relaxed">
          Entanglo updates itself peer-to-peer. If one of your Macs already runs a newer version,
          the others pick up the DMG over the LAN automatically. You can also drop in this DMG
          manually any time — your pairing and trusted devices survive the upgrade.
        </p>
      </div>
    </div>
  </section>

  <AdSlot slot="download-bottom" />

  <section class="container-narrow py-12 text-center text-ink-400 text-sm">
    Signature (ad-hoc) means the app is identified to macOS without an Apple Developer account.
    The first launch may require a right-click → Open.
  </section>
</Base>
