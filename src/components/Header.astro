---
import Logo from './Logo.astro';

const nav = [
  { href: '/#features', label: 'Features' },
  { href: '/download', label: 'Download' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/support', label: 'Support' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-cream-50/75 border-b border-ink-950/[0.08]">
  <div class="container-narrow flex items-center justify-between h-14">
    <Logo />
    <nav class="hidden md:flex items-center gap-7 text-sm text-ink-700">
      {nav.map(item => (
        <a href={item.href} class="hover:text-ink-950 transition-colors">{item.label}</a>
      ))}
    </nav>
    <a href="/download" class="text-sm rounded-full bg-ink-950 text-cream-50 px-4 py-1.5 font-medium hover:bg-ink-900 transition-colors">
      Get Entanglo
    </a>
  </div>
</header>
