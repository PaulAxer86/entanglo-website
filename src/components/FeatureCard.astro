---
interface Props {
  title: string;
  description: string;
  icon: string;
  highlight?: boolean;
}
const { title, description, icon, highlight = false } = Astro.props;
---

<div class={`glass glass-hover p-7 group ${highlight ? 'md:col-span-2 md:row-span-2' : ''}`}>
  <div class={`w-11 h-11 rounded-xl flex items-center justify-center mb-5
               bg-gradient-to-br from-accent/20 to-accent-cyan/10
               border border-white/10 text-accent-glow
               group-hover:scale-105 transition-transform`}>
    <Fragment set:html={icon} />
  </div>
  <h3 class={`display ${highlight ? 'text-2xl md:text-3xl' : 'text-xl'} text-white mb-2`}>
    {title}
  </h3>
  <p class="text-ink-300 text-sm leading-relaxed">
    {description}
  </p>
</div>
