---
interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle';
  label?: string;
}
const { slot = '', format = 'auto', label = 'Advertisement' } = Astro.props;
---

<aside class="my-12" aria-label={label}>
  <div class="container-narrow">
    <div class="text-[10px] uppercase tracking-widest text-ink-400 text-center mb-2">
      {label}
    </div>
    <div class="glass min-h-[120px] flex items-center justify-center text-ink-400 text-sm">
      <!--
        Google AdSense slot — empty until ca-pub-XXXXX approved.
        Uncomment after enabling the script in Base.astro.

        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
             data-ad-slot={slot}
             data-ad-format={format}
             data-full-width-responsive="true"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      -->
      <span class="opacity-50">Ad slot ({slot || 'unassigned'})</span>
    </div>
  </div>
</aside>
