---
interface Props {
  href: string;
  version: string;
  size?: string;
}
const { href, version, size } = Astro.props;
---

<a href={href} class="btn-primary text-base px-7 py-4">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  </svg>
  <span>Download {version}{size ? ` · ${size}` : ''}</span>
</a>
