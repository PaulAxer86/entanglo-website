---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-950/[0.08] mt-32">
  <div class="container-narrow py-14 grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <Logo />
      <p class="text-ink-600 text-sm mt-4 max-w-sm leading-relaxed">
        Native macOS link for your Macs. Share input, clipboard, files, and a printer across the same Wi-Fi — no cloud, no account.
      </p>
    </div>
    <div>
      <div class="text-xs uppercase tracking-wider text-ink-500 mb-3">Product</div>
      <ul class="space-y-2 text-sm text-ink-700">
        <li><a href="/#features" class="hover:text-ink-950">Features</a></li>
        <li><a href="/download" class="hover:text-ink-950">Download</a></li>
        <li><a href="/changelog" class="hover:text-ink-950">Changelog</a></li>
      </ul>
    </div>
    <div>
      <div class="text-xs uppercase tracking-wider text-ink-500 mb-3">Source</div>
      <ul class="space-y-2 text-sm text-ink-700">
        <li><a href="https://github.com/PaulAxer86/entanglo-macos" class="hover:text-ink-950">macOS · GitHub</a></li>
        <li><a href="https://github.com/PaulAxer86/entanglo-windows" class="hover:text-ink-950">Windows · GitHub</a></li>
        <li><a href="https://github.com/PaulAxer86/entanglo-android" class="hover:text-ink-950">Android · GitHub</a></li>
      </ul>
    </div>
    <div>
      <div class="text-xs uppercase tracking-wider text-ink-500 mb-3">Company</div>
      <ul class="space-y-2 text-sm text-ink-700">
        <li><a href="/support" class="hover:text-ink-950">Support</a></li>
        <li><a href="/privacy" class="hover:text-ink-950">Privacy</a></li>
        <li><a href="mailto:support@entanglo.app" class="hover:text-ink-950">support@entanglo.app</a></li>
      </ul>
    </div>
  </div>
  <div class="container-narrow pb-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-xs text-ink-500">
    <div>© {year} Paolo Asara. All rights reserved.</div>
    <div>Built for macOS 13+ — Apple Silicon &amp; Intel.</div>
  </div>
</footer>
